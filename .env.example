# Môi trường Ứng dụng: local | staging | production
VITE_APP_ENV=local

# Tên ứng dụng hiển thị
VITE_APP_TITLE=LucidTask MVP

# Cấu hình Bật/Tắt Log Telemetry ngầm trên Console (Bật khi local debug)
VITE_DEBUG_TELEMETRY=true

# Giới hạn thời gian mặc định của Chặng 1 và Chặng 2 (giây)
VITE_STAGE1_TIME_LIMIT_SEC=90
VITE_STAGE2_TIME_LIMIT_SEC=210

# Bật/Tắt chế độ giả lập dữ liệu (Mock Mode)
VITE_USE_MOCK_SEED_DATA=true

